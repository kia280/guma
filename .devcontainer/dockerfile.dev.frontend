FROM node:24.14.1-alpine

# Set working directory
WORKDIR /workspace

# Pre-create node_modules so the named volume inherits node:node ownership
RUN mkdir -p /workspace/web/node_modules && chown -R node:node /workspace/web/node_modules

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3000 2>/dev/null || echo "waiting"

USER node
ENTRYPOINT ["sh", "-c", "npm install && npm run dev"]