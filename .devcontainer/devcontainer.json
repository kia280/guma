{
  "name": "Guma Development",
  "dockerComposeFile": ["../docker/docker-compose.dev.yml", "docker-compose.devcontainer.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",

  // Configure Features
  "features": {
    "ghcr.io/devcontainers/features/node:1.6.3": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2.12.4": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1.0.15": {},
    "ghcr.io/devcontainers/features/go:1.3.2": {},
    "ghcr.io/devcontainers-extra/features/protoc:1.0.3": {},
    "ghcr.io/devcontainers-extra/features/ory-kratos:1.0.6": {},
    "ghcr.io/rails/devcontainer/features/postgres-client:1.1.3": {}
  },

  // Configure tool-specific properties
