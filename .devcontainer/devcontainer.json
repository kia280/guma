  //     "extensions": [
  //       "golang.go",
  //       "ms-vscode.vscode-typescript-next",
  //       "bradlc.vscode-tailwindcss",
  //       "esbenp.prettier-vscode",
  //       "ms-vscode.vscode-json",
  //       "redhat.vscode-yaml",
  //       "ms-python.python",
  //       "bufbuild.vscode-buf",
  //       "zxh404.vscode-proto3",
  //       "ms-vscode.makefile-tools",
  //       "GitHub.copilot",
  //       "GitHub.copilot-chat"
  //     ],
  //     "settings": {
  //       "go.toolsManagement.checkForUpdates": "local",
  //       "go.useLanguageServer": true,
  //       "go.gopath": "/go",
  //       "go.goroot": "/usr/local/go",
  //       "editor.formatOnSave": true,
  //       "editor.codeActionsOnSave": {
  //         "source.organizeImports": "explicit"
  //       },
  //       "files.eol": "\n",
  //       "terminal.integrated.defaultProfile.linux": "bash"
  //     }
  //   }
  // },

  // Use 'forwardPorts' to make a list of ports inside the container available locally
  "forwardPorts": [
    3000,  // Next.js frontend
    8080,  // Go backend
    5432,  // PostgreSQL
    6379,  // Redis
    9000,  // MinIO
    9001,  // MinIO Console
    4433,  // Kratos
    4434   // Kratos Admin
  ],

  "portsAttributes": {
    "3000": {
      "label": "Frontend (Next.js)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Backend (Go)",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL"
    },
    "6379": {
      "label": "Redis"
    },
    "9000": {
      "label": "MinIO API"
    },
    "9001": {
      "label": "MinIO Console"
    }
  },

  // Commands to run after the container is created
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Commands to run when attaching to the container
  "postAttachCommand": {
    "server": "echo 'Run: make serve' to start the backend server",
    "frontend": "echo 'Run: make web-dev' to start the frontend",
    "setup": "echo 'Run: make setup' for first-time setup"
  },

  // 

  // Set environment variables
  "containerEnv": {
    "GOOS": "linux",
    "GOARCH": "amd64",
    "CGO_ENABLED": "0",
    "DATABASE_URL": "postgres://guma:password@localhost:5432/guma?sslmode=disable",
    "REDIS_URL": "redis://localhost:6379/0",
    "MINIO_ENDPOINT": "localhost:9000",
    "MINIO_ACCESS_KEY": "minioadmin",
    "MINIO_SECRET_KEY": "minioadmin",
    "PORT": "8080",
    "ENV": "development"
  },

  // Mount the workspace and preserve command history
  "mounts": [
    // "source=guma-go-mod-cache,target=/go/pkg/mod,type=volume",
    // "source=guma-node-modules,target=${containerWorkspaceFolder}/web/node_modules,type=volume",
    // "source=guma-vscode-extensions,target=/home/vscode/.vscode-server/extensions,type=volume"
  ],

  // Configure user settings
  "remoteUser": "vscode",
  "updateRemoteUserUID": true
}
