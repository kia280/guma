# Guma Application Configuration (YAML)
# This is an example configuration file showing all available options.
# Copy this to config.yaml and customize for your environment.
# Note: Environment variables take precedence over config file values.

# Server configuration
server:
  port: 8080
  host: localhost
  env: development
  grpc_port: 50051

# Database configuration
database:
  url: postgres://guma:password@localhost:5432/guma?sslmode=disable
  max_open_conns: 25
  max_idle_conns: 5

# Authentication configuration
auth:
  kratos_public_url: http://localhost:8081
  kratos_admin_url: http://localhost:4434

# Guild authorization (Ory Keto gRPC APIs)
# Env overrides: KETO_READ_ADDR, KETO_WRITE_ADDR, KETO_OUTBOX_SWEEP_INTERVAL
keto:
  read_addr: localhost:4466
  write_addr: localhost:4467
  outbox_sweep_interval: 5s  # retry cadence for pending membership syncs

# Logging configuration
logging:
  level: debug  # debug, info, warn, error
  format: text  # json, text

# CORS configuration
cors:
  allowed_origins:
    - http://localhost:3000
    - http://localhost:8080
  allowed_methods:
    - GET
    - POST
    - PUT
    - PATCH
    - DELETE
    - OPTIONS
  allowed_headers:
    - Content-Type
    - Authorization

# Background job scheduling
scheduler:
  raffle_draw_interval: 15s  # set to 0 to disable
  auction_settle_interval: 15s  # set to 0 to disable

# OpenTelemetry metrics (OTLP export). Disabled by default; no collector needed for local dev.
# Env overrides: METRICS_ENABLED, METRICS_ENDPOINT, METRICS_PROTOCOL, METRICS_INSECURE,
# METRICS_HEADERS, METRICS_EXPORT_INTERVAL. Standard OTEL_EXPORTER_OTLP_* and
# OTEL_RESOURCE_ATTRIBUTES variables are also honored.
metrics:
  enabled: false
  endpoint: ""  # host:port or URL (e.g. localhost:4317, https://otlp.example.com/v1/metrics); empty uses OTLP defaults
  protocol: grpc  # grpc, http/protobuf
  insecure: false  # plaintext connection to the collector
  headers: ""  # key=value,key2=value2 (e.g. auth tokens)
  export_interval: 15s  # how often metrics are collected and exported

# Distributed tracing (OpenTelemetry, OTLP export). Disabled by default.
tracing:
  enabled: false
  # host:port, or a full URL such as http://otel-collector:4318.
  # Empty uses the OTLP default (localhost:4317 for grpc, localhost:4318 for http/protobuf)
  # and honors the standard OTEL_EXPORTER_OTLP_* environment variables.
  endpoint: ""
  protocol: grpc  # grpc, http/protobuf
  insecure: false  # disable TLS towards the collector
  headers: ""  # comma-separated key=value pairs, e.g. authorization=Bearer token
  sample_rate: 1.0  # 0.0-1.0 ratio of new traces to sample; parent decisions are respected
